# 环境变量示例
#
# 复制成 .env 后按需填写。.env 已在 .gitignore 里，不会被提交。
# astra-server 启动时会在解析 flag 之前加载 .env；已经 export 的变量优先，
# 方便临时覆盖（例如 MILVUS_ADDR= 直接关掉记忆）。桌面端走界面设置，不读 .env。
# 支持行尾注释：KEY=value  # 注释；值本身含 # 请用引号包住。

# ── 模型凭据 ────────────────────────────────────────
# 上游真 key，只给控制面用。不进沙箱——沙箱里拿到的是网关签发的短期虚拟 key。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 存储 ───────────────────────────────────────────
# sqlite（默认，零依赖）/ postgres
ASTRA_STORE=sqlite
# ASTRA_DSN=postgres://user:pass@127.0.0.1:5432/astra?sslmode=disable

# ── 认证 ───────────────────────────────────────────
# 留空则首次启动生成并落盘到 <dataDir>/jwt-secret（0600）。
# 多副本部署时必须显式给同一个值，否则各副本签发的 token 互不认。
# ASTRA_JWT_SECRET=

# ── 沙箱 ───────────────────────────────────────────
# local / applecontainer / cube
ASTRA_SANDBOX_PROVIDER=local
# cube 需要控制面地址与凭据（CubeSandbox 是 e2b 兼容数据面）
# ASTRA_CUBE_API=http://cube-api.example.com:3000
# ASTRA_CUBE_TOKEN=
# 覆盖 agent 启动命令（例如指向自己那份 dsh）
# ASTRA_AGENT=node /path/to/dsh/lib/bin.js --profile acp

# ── 其他 ───────────────────────────────────────────
# 监听地址：0.0.0.0 才能被同网段手机访问
ASTRA_ADDR=127.0.0.1:7788
# 数据目录（数据库、沙箱工作区、密钥文件）
# ASTRA_DATA=./data

# ── 长期记忆（Milvus）──────────────────────────────
# 留空 = 关闭记忆能力（/v1/meta 会显示 memory=false，平台照常可用）。
# 对应 make vector-up 起的 deploy/vector/compose.yaml。
MILVUS_ADDR=            # 127.0.0.1:19530；留空=关闭记忆能力
MILVUS_DB=default
MILVUS_COLLECTION=astra_memory
# Embedding 端点：任何兼容 OpenAI /embeddings 的服务都能用（自建 vLLM、one-api、云厂商）。
# 留空则退回 hash 实现 —— 只保证「能跑通链路」，语义检索质量为零，**仅联调**。
# ⚠️ 换成别的模型时维度会变，而 collection 的维度在首次建表时固定：
#    换模型 = 换 collection 名（或先删旧 collection），否则写入会直接报维度不匹配。
MEMORY_EMBED_BASE_URL=  # 兼容 /embeddings 的端点；留空用 hash（仅联调）
MEMORY_EMBED_API_KEY=
MEMORY_EMBED_MODEL=text-embedding-3-small
MEMORY_EMBED_DIM=       # 留空自动探测

# ── 观测（Langfuse）────────────────────────────────
# 留空 = 关闭观测（/v1/meta 会显示 obs=false，上报静默跳过）。
# 对应 make obs-up 起的 deploy/observability/compose.yaml。
# PUBLIC_KEY / SECRET_KEY 在首启时由 LANGFUSE_INIT_* 自动创建，
# 默认值就是 compose 里的 pk-lf-astra-dev / sk-lf-astra-dev。
LANGFUSE_HOST=          # http://127.0.0.1:3000；留空=关闭观测
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 采样率：1=全采，0.1=十留一。trace 里含用户输入输出，量大时先降采样再考虑扩容
LANGFUSE_SAMPLE_RATE=1
LANGFUSE_DASHBOARD_URL= # 留空则同 HOST

# ── 出网管控（默认关闭）────────────────────────────
# 留空 = 沙箱直连，平台行为与旧版一致。配了才给沙箱注入 HTTP_PROXY，
# 默认策略是 deny + 拦私网，按租户域名白名单放行（GET/PUT /v1/admin/egress/policy）。
# EGRESS_LISTEN_ADDR=127.0.0.1:17890
# ⚠ 开代理后 agent 连本机 LLM 网关会被私网规则拦掉，症状是「每个 run 都报模型连不上」。
#   LLMPublicURL 指向 127.0.0.1/localhost 时会自动放行那一个 host:port；
#   其它情况用下面这个显式指定（逗号分隔，只写必需的地址，别填 *）。
# EGRESS_NO_PROXY=127.0.0.1:7788
# 强制边界（默认关闭）：给沙箱套 Seatbelt 网络规则，出网只准连本机代理端口，
# 从操作系统层堵住「代码忽略 HTTP_PROXY 直连外网」。要求代理已启用、端口正确。
# ⚠ 规则写错或代理没起 = 所有 agent 断网，报错只是 Operation not permitted，
#   极难排查。只在你确认代理就绪、且已在非嵌套环境验证过规则后才开。
# ASTRA_NETWORK_LOCK=false

# ── 调度 / 技能沉淀 / 浏览器（默认开启，无需配置）──
# 这三项开箱可用；要关就把对应项设成 false。
# SCHEDULER_ENABLED=false
# DISTILL_ENABLED=false
# BROWSER_ENABLED=false
# 多 agent 协作与行动账本（默认开启）
# COLLAB_ENABLED=false
# COLLAB_MAX_DEPTH=2
# COLLAB_TIMEOUT_MIN=5
# SKILL_DIR=                  # 技能落盘目录，默认 ~/.astra/skills
# SCHEDULER_MAX_PER_TENANT=50
# CHROME_PATH=                # 留空自动探测系统 Chrome
# BROWSER_MAX_SESSIONS=4
# BROWSER_HEADLESS=true

# ── 连接器 / 凭据库（默认关闭）────────────────────
# 32 字节主密钥的 base64：`openssl rand -base64 32`。
# 没有密钥就不开——明文存 token 不如不存。
# ASTRA_VAULT_KEY=
# ASTRA_VAULT_PATH=           # 默认 ~/.astra/vault.json（0600）
# ASTRA_BASE_URL=http://127.0.0.1:7788
# 注入模式（默认 proxy）：沙箱只拿到本地 sidecar 地址（GITHUB_API_BASE 等），
# token 留在控制面，由出网代理在转发时注入 Authorization。
# ⚠ proxy 模式**要求出网代理已启用**（EGRESS_LISTEN_ADDR），否则 Inject 会明确报错。
# ⚠ agent 必须把这个地址设成 SDK 的 base URL；SDK 直连官方 https 域名时走 CONNECT
#   隧道，代理看不到明文，无法注入 token（不做 MITM）。这是设计边界，不是 bug。
# env 模式会把 token 明文放进沙箱环境变量，仅可信 agent + 短 token 可用。
# CONNECTOR_INJECT_MODE=proxy
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# ── 语音 ──────────────────────────────────────────
# 纯前端浏览器原生 STT/TTS，无服务端配置。Chrome 支持最好，Safari 需用户手势，
# Firefox 不支持语音识别；浏览器与局限见 web/src/voice/README.md。
