# 环境变量示例
#
# 复制成 .env 后按需填写。.env 已在 .gitignore 里，不会被提交。
# 服务本身不读 .env（Go 不自动加载），这里只是给部署脚本/docker-compose 用的清单；
# 直接跑二进制时用命令行参数（见 README）。

# ── 模型凭据 ────────────────────────────────────────
# 上游真 key，只给控制面用。不进沙箱——沙箱里拿到的是网关签发的短期虚拟 key。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 存储 ───────────────────────────────────────────
# sqlite（默认，零依赖）/ postgres
ASTRA_STORE=sqlite
# ASTRA_DSN=postgres://user:pass@127.0.0.1:5432/astra?sslmode=disable

# ── 认证 ───────────────────────────────────────────
# 留空则首次启动生成并落盘到 <dataDir>/jwt-secret（0600）。
# 多副本部署时必须显式给同一个值，否则各副本签发的 token 互不认。
# ASTRA_JWT_SECRET=

# ── 沙箱 ───────────────────────────────────────────
# local / applecontainer / cube
ASTRA_SANDBOX_PROVIDER=local
# cube 需要控制面地址与凭据（CubeSandbox 是 e2b 兼容数据面）
# ASTRA_CUBE_API=http://cube-api.example.com:3000
# ASTRA_CUBE_TOKEN=
# 覆盖 agent 启动命令（例如指向自己那份 dsh）
# ASTRA_AGENT=node /path/to/dsh/lib/bin.js --profile acp

# ── 其他 ───────────────────────────────────────────
# 监听地址：0.0.0.0 才能被同网段手机访问
ASTRA_ADDR=127.0.0.1:7788
# 数据目录（数据库、沙箱工作区、密钥文件）
# ASTRA_DATA=./data

# ── 长期记忆（Milvus）──────────────────────────────
# 留空 = 关闭记忆能力（/v1/meta 会显示 memory=false，平台照常可用）。
# 对应 make vector-up 起的 deploy/vector/compose.yaml。
MILVUS_ADDR=            # 127.0.0.1:19530；留空=关闭记忆能力
MILVUS_DB=default
MILVUS_COLLECTION=astra_memory
# Embedding 端点：任何兼容 OpenAI /embeddings 的服务都能用（自建 vLLM、one-api、云厂商）。
# 留空则退回 hash 实现 —— 只保证「能跑通链路」，语义检索质量为零，**仅联调**。
# ⚠️ 换成别的模型时维度会变，而 collection 的维度在首次建表时固定：
#    换模型 = 换 collection 名（或先删旧 collection），否则写入会直接报维度不匹配。
MEMORY_EMBED_BASE_URL=  # 兼容 /embeddings 的端点；留空用 hash（仅联调）
MEMORY_EMBED_API_KEY=
MEMORY_EMBED_MODEL=text-embedding-3-small
MEMORY_EMBED_DIM=       # 留空自动探测

# ── 观测（Langfuse）────────────────────────────────
# 留空 = 关闭观测（/v1/meta 会显示 obs=false，上报静默跳过）。
# 对应 make obs-up 起的 deploy/observability/compose.yaml。
# PUBLIC_KEY / SECRET_KEY 在首启时由 LANGFUSE_INIT_* 自动创建，
# 默认值就是 compose 里的 pk-lf-astra-dev / sk-lf-astra-dev。
LANGFUSE_HOST=          # http://127.0.0.1:3000；留空=关闭观测
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 采样率：1=全采，0.1=十留一。trace 里含用户输入输出，量大时先降采样再考虑扩容
LANGFUSE_SAMPLE_RATE=1
LANGFUSE_DASHBOARD_URL= # 留空则同 HOST
